{
  "name": "inspectra",
  "version": "0.1.0",
  "private": true,
  "description": "Inspectra monorepo - Next.js web app + NestJS API, managed with pnpm workspaces and Turborepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@inspectra/web",
    "dev:api": "turbo run dev --filter=@inspectra/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@inspectra/web",
    "build:api": "turbo run build --filter=@inspectra/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d postgres redis",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f api web",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.3"
  }
}
