# ================================
# Inspectra Monorepo .gitignore
# apps/: Next.js (web) + NestJS (api)
# ================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
bun.lockb
# Package manager lockfiles: keep ONE (uncomment the ones you don't use)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Build outputs ---
dist/
build/
out/
.next/
.nuxt/
*.tsbuildinfo
next-env.d.ts

# --- NestJS ---
/apps/*/dist
nest-cli.json.bak

# --- Prisma (regenerated by `prisma generate`) ---
/apps/api/src/generated/

# --- Monorepo tooling (Turborepo / Nx) ---
.turbo/
.nx/
.nx_workspace/
.tsbuildinfo

# --- Testing / Coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/
cypress/videos/
cypress/screenshots/
*.lcov
junit*.xml

# --- Env & secrets ---
# Ignore all env files except examples
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/

# --- Logs & debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# --- TypeScript / ESLint caches ---
*.js.map
.eslintcache
.stylelintcache
.prettiercache
biome.jsonc.bak

# --- Misc tooling ---
.cache/
.tmp/
temp/
tmp/
.parcel-cache/
.rpt2_cache/
.rts2_cache_*
.storybook-out/
chromatic/
vercel
.vercel
.netlify/
wrangler/
.dev.vars
sst/
.terraform/
.terraform.lock.hcl
terraform.tfstate*
*.tfvars
.claude/

# --- Docker (keep Dockerfiles/docker-compose, ignore overrides & data) ---
docker/docker-compose.override.yml
docker/data/
docker/volumes/
*.dockerenv

# --- Local uploads / generated ---
uploads/
public/uploads/
storage/
*.sqlite
*.sqlite-journal
*.db
context/

# --- Git ---
*.orig
*.rej
