# Copy to `apps/web/.env.local` (gitignored) and fill in the Clerk key. Both values
# are read at build/dev start: restart `next dev` after changing them.
#
# Where the Next.js server proxies /api/* (see next.config.ts). Read at build/dev start,
# so restart `next dev` after changing it. The Docker image sets it to http://api:3001.
API_INTERNAL_URL=http://localhost:3001

# Sign-in (required). Same Clerk instance as CLERK_SECRET_KEY in apps/api/.env.
# Clerk Dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
