# Copy to `apps/web/.env.local` (gitignored) only if the API isn't on localhost:3001.
#
# Where the Next.js server proxies /api/* (see next.config.ts). Read at build/dev start,
# so restart `next dev` after changing it. The Docker image sets it to http://api:3001.
API_INTERNAL_URL=http://localhost:3001
