# Copy to `apps/web/.env.local` (gitignored) if the API isn't on localhost:3001 or
# to turn on Clerk accounts. Both are read at build/dev start: restart `next dev`.
#
# Where the Next.js server proxies /api/* (see next.config.ts). Read at build/dev start,
# so restart `next dev` after changing it. The Docker image sets it to http://api:3001.
API_INTERNAL_URL=http://localhost:3001

# Clerk accounts. Set together with AUTH_MODE=clerk + CLERK_SECRET_KEY in apps/api/.env.
# Leave empty for demo-only sign-in. Clerk Dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
