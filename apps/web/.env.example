# Copy to `apps/web/.env.local` (gitignored) if you need to override defaults.
#
# Used by server components / route handlers only.
API_URL=http://localhost:3001/api

# Uncomment when you start calling the API from the browser instead of the
# server; NEXT_PUBLIC_* values are inlined into the client bundle.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
