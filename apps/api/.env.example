# Copy to `apps/api/.env` (gitignored) before running `pnpm dev:api`.
NODE_ENV=development
PORT=3001

# Origin allowed by CORS (the Next.js dev server).
WEB_ORIGIN=http://localhost:3000

# Postgres and Redis from `docker compose -f docker/docker-compose.yml up -d postgres redis`.
DATABASE_URL=postgresql://inspectra:inspectra@localhost:5432/inspectra
# Leave REDIS_URL unset to run without the hourly generation job (e.g. in tests).
REDIS_URL=redis://localhost:6379

# Sign-in.
#   demo  - no accounts: the web app sends `x-user-id` for one of the seeded users.
#   clerk - Clerk accounts (Authorization: Bearer <session token>). One-click demo
#           logins still work, but only for the seeded demo organizations.
AUTH_MODE=demo

# Needed when AUTH_MODE=clerk. Clerk Dashboard -> API keys (same instance as the
# web app's publishable key). WEB_ORIGIN above doubles as the allowed token origin.
CLERK_SECRET_KEY=
# Optional: PEM public key (Dashboard -> API keys -> JWT public key) to verify
# tokens without fetching Clerk's JWKS.
CLERK_JWT_KEY=
